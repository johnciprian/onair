<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The release certificate is self-signed, so neither OnAir nor its bundled Sparkle framework has a Team ID,
	     and library validation would refuse to load Sparkle. The rest of the hardened runtime stays on
	     (including the block on injecting code through DYLD environment variables). -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
